# Enforce LF line endings for all text files in this repository.
# This prevents "LF will be replaced by CRLF" warnings on Windows
# and ensures consistent line endings across all platforms.

# Default: normalize all text files to LF on commit
* text=auto eol=lf

# --- Source code ---
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.rs        text eol=lf

# --- Config / markup ---
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf

# --- Docs ---
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf

# --- Shell / config ---
*.sh        text eol=lf
*.conf      text eol=lf
.env*       text eol=lf
Dockerfile* text eol=lf
*.dockerfile text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# --- Binary: never touch line endings ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.node      binary

# Binary test fixtures (e.g. in a vendored build workspace) must never be
# line-ending normalized.
*.bin binary

# --- spec-spine derived shards (spec 008) ---
# Registers the merge driver (spec-spine spec 020) on the committed shard
# globs. The driver itself is opt-in per clone: it does nothing until
# `./.githooks/enable-merge-driver.sh` registers it in that clone's git
# config, and a clone that never runs it behaves exactly as before.
#
# Sharding (spec 024) already removes the common conflict, since two PRs
# touching different specs or packages write disjoint files. This is for the
# same-shard case: two PRs editing the same authority unit.
#
# It never replaces the `index check` staleness gate. The driver resolves a
# textual conflict by regenerating from the merged tree; the gate is what
# proves the result is what the corpus compiles to.
.derived/spec-registry/by-spec/*.json merge=spec-spine-derived-regen
.derived/codebase-index/by-spec/*.json merge=spec-spine-derived-regen
.derived/codebase-index/by-package/*.json merge=spec-spine-derived-regen
.derived/codebase-index/slices.json merge=spec-spine-derived-regen
