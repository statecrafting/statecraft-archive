# =============================================================================
# OAP Hetzner Deployment — Environment Configuration
# =============================================================================
# Copy to your operator config home:  cp .env.example ~/.config/oap/infra/hetzner/.env
# Then fill in HCLOUD_TOKEN and run:  ./setup.sh
#
# Secrets marked [auto] are generated automatically if left empty.
# Secrets marked [manual] require you to create them externally first.
# =============================================================================

# region: env-vars
# --- Required: Hetzner Cloud ---
HCLOUD_TOKEN=

# --- Required: Domain (change if using a different domain) ---
DOMAIN=<your-domain-name>
APP_BASE_URL=https://<your-domain-name>
LETSENCRYPT_EMAIL=admin@<your-domain-name>
RAUTHY_URL=https://auth.<your-domain-name>
# endregion env-vars

STATECRAFT_AUDIT_SWEEPER_CLIENT_ID=
STATECRAFT_AUDIT_SWEEPER_CLIENT_SECRET=
STATECRAFT_FACTORY_SWEEPER_CLIENT_ID=
STATECRAFT_FACTORY_SWEEPER_CLIENT_SECRET=
STATECRAFT_KNOWLEDGE_SWEEPER_CLIENT_ID=
STATECRAFT_KNOWLEDGE_SWEEPER_CLIENT_SECRET=

# --- [auto] Generated on first run if empty ---
POSTGRES_PASSWORD=
SESSION_SECRET=
# --- Rauthy OIDC (each must be >= 16 chars) ---
RAUTHY_RAFT_SECRET=
RAUTHY_API_SECRET=
RAUTHY_ADMIN_PASSWORD=
RAUTHY_ENC_KEY_ID=
RAUTHY_ENC_KEY=
HIQLITE_SECRET_RAFT=
HIQLITE_SECRET_API=
GITHUB_WEBHOOK_SECRET=

# --- [manual] SMTP Email Settings ---
# Required for Rauthy magic-link login (spec 137 evidence path).
# Gmail: create an App Password at https://myaccount.google.com/apppasswords.
# Rauthy enforces TLS (STARTTLS or implicit TLS). It never sends cleartext;
# `SMTP_DANGER_INSECURE=true` is local-dev only.
#
# **Hetzner Cloud blocks outbound TCP on port 465** (implicit-TLS / SMTPS),
# confirmed empirically 2026-05-17 — a Rauthy startup probe against
# smtp.gmail.com:465 from a worker pod times out at the kernel layer
# (Network is unreachable). Port 587 (STARTTLS submission) is reachable
# and functionally equivalent for Gmail and most SMTP providers. Default
# below is 587 for that reason; use 465 only on providers that don't
# block it (verify with `nc -vz smtp.<provider>.com 465` from inside the
# cluster first).
SMTP_FROM='Rauthy <rauthy@your-domain-name>'
SMTP_URL=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# --- [manual] Google OAuth App ---
# Create at: https://console.cloud.google.com/auth/clients
#   Homepage URL:  https://<your-domain-name>
#   Callback URL:  https://<your-domain-name>/auth/v1/providers/callback
GOOGLE_UPSTREAM_CLIENT_ID=
GOOGLE_UPSTREAM_CLIENT_SECRET=

# --- [manual] GitHub OAuth App ---
# Create at: https://github.com/settings/developers
#   Homepage URL:  https://<your-domain-name>
#   Callback URL:  https://<your-domain-name>/auth/v1/providers/callback
GITHUB_UPSTREAM_CLIENT_ID=
GITHUB_UPSTREAM_CLIENT_SECRET=

# --- [manual] GitHub App ---
# Create at: https://github.com/settings/apps/new
#   Webhook URL:   https://<your-domain-name>/api/github/webhook
#   Webhook secret: use the auto-generated GITHUB_WEBHOOK_SECRET above
#   Permissions:   Contents (read), Pull requests (read/write), Metadata (read)
#   Events:        Push, Pull request
GITHUB_APP_ID=
# Store as base64: base64 -w0 < private-key.pem  (Linux) or base64 -i private-key.pem (macOS)
GITHUB_APP_PRIVATE_KEY_B64=

# --- [manual] OIDC clients (created in Rauthy admin after Phase 1) ---
# Log into https://auth.<your-domain-name> after Phase 1 completes.
# Create SPA + M2M + server clients, then fill these in and re-run ./setup.sh
OIDC_SPA_CLIENT_ID=
OIDC_M2M_CLIENT_ID=
OIDC_M2M_CLIENT_SECRET=
RAUTHY_CLIENT_ID=
RAUTHY_CLIENT_SECRET=
RAUTHY_ADMIN_TOKEN=

# --- [manual] Grafana OIDC client (spec 196, created in Rauthy admin) ---
# Create after the metrics stack lands (spec 196 Phase 2):
#   Client ID:     grafana   (confidential; flow: authorization_code + PKCE)
#   Redirect URI:  https://grafana.<your-domain-name>/login/generic_oauth
#                  (EXACT match — no wildcards, prefixes, or trailing slash)
#   Scopes:        openid email profile oap  (oap maps the platform_role claim)
# Then fill these in and re-run ./setup.sh — it materialises the
# `grafana-oidc` Secret in the monitoring namespace; the Grafana pod
# blocks on that Secret until then.
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=

# --- [manual] Cloudflare API token ---
#  Go to https://dash.cloudflare.com/profile/api-tokens → Create Token → Custom token:
#  - Permissions: Zone → DNS → Edit
#  - Zone Resources: Include → Specific zone → <your-domain-name>
#  - TTL: leave at default
CLOUDFLARE_DNS_API_TOKEN=

# --- [manual] GHCR image pull (for pulling private container images) ---
# A GitHub PAT with read:packages scope, used for:
#   1. Creating K8s image-pull secrets so pods can pull from ghcr.io
#   2. Syncing to GitHub Actions secrets (if gh CLI is available)
GHCR_PAT=

# --- [manual] GitHub Token (for `flux bootstrap`) ---
# Required by setup.sh's pre-flight before `flux bootstrap github` (spec 151
# T-007). flux uses it to push the gotk-* manifests to this repo and create
# the deploy key the source-controller pulls with.
#
# Easiest path — reuse the gh CLI's stored credential:
#   export GITHUB_TOKEN="$(gh auth token)"
#
# Fine-grained PAT alternative (https://github.com/settings/personal-access-tokens):
#   - Repository access:  open-agentic-platform
#   - Permissions:        Contents (read/write), Administration (read/write)
#                         — Administration is needed for the deploy-key write
#
# Note: `statecrafting` org default-disables deploy keys (dr-baseline F6).
# Either ask org-admin to enable Settings → Repository policies → Deploy keys,
# or run `flux bootstrap --token-auth` (in-cluster long-lived PAT trade-off).
GITHUB_TOKEN=

# --- [manual] PAT Encryption Key ---
# Bash(PAT_KEY=$(openssl rand -base64 32); echo "Generated key (32 bytes base64, length=$(echo -n "$PAT_KEY" | wc -c | tr -d ' ')):"; echo "$PAT_KEY")
# OR
# cd platform/services/statecraft && openssl rand -base64 32 | encore secret set --type dev PAT_ENCRYPTION_KEY
# repeat for --type local, prod, preview as needed
PAT_ENCRYPTION_KEY=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Optional ---
SLACK_WEBHOOK_URL=
