# IDE
.idea/
_tmp/

# Stray build/ dirs if a tool is run from its own crate directory instead
# of the repo root. Tool-local build/ output is never canonical.
tools/*/build/

# .derived/: generated-artifacts root (I9 cutover from build/). Ignore each
# subdir's contents, then re-include the committed shard trees. Spec 217
# Workstream D re-commits the sharded per-unit registry + index trees
# (`by-spec/`, `by-package/`), superseding spec 188 Phase 4b's de-commit of the
# monolithic `index.json`: disjoint per-spec files cannot textually collide, so
# the merge queue still forms clean speculative stacks while present-on-clone
# (spec 101 SC-06) is restored. The monolithic `index.json` / `registry.json`
# are never emitted again (spec-spine 0.8.0 emits only shards). `build-meta.json`
# (ephemeral wall-clock) and the OAP overlay outputs (`index-oap.json`,
# `CODEBASE-INDEX.md`) stay gitignored and rebuilt on demand. `config-hash.json`
# (spec 188 Phase 4a) and `slices.json` stay committed: `slices.json` is the
# spec 184 config-slice gate reference that the `spec-spine index check --slice`
# consumer reads on a fresh clone, so it must be present in git (the ci-parity
# producer/consumer gate enforces this).
.derived/spec-registry/*
!.derived/spec-registry/by-spec/
.derived/codebase-index/*
!.derived/codebase-index/by-spec/
!.derived/codebase-index/by-package/
!.derived/codebase-index/config-hash.json
!.derived/codebase-index/slices.json
.derived/schema-parity/*
.axiomregent/
.fastembed_cache/

# xray test outputs (regenerated by cargo test)
crates/xray/tests/outputs/

# OAP background agent worktrees (051-worktree-agents)
.worktrees/

# Claude Code personal settings (machine-specific overrides)
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Per-agent learned memory: local, regenerable scratch (not a governed surface)
.claude/agent-memory/

# Platform layer
platform/kubeconfig/
platform/tmp/
platform/_tmp_test/

# Local dev runtime data
.local/

# Spec 134: shared CARGO_TARGET_DIR for ci-fast-tools fan-out (CIFAST_TARGET_DIR)
.target/